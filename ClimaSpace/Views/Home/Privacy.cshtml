@{
    ViewData["Title"] = "Acerca de & Privacidad";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="white-card p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="brand-icon-wrapper" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        <i class="bi bi-shield-check text-white"></i>
                    </span>
                    <div>
                        <h1 class="h3 fw-bold mb-0 text-primary">Acerca de ClimaSpace &amp; Privacidad</h1>
                        <p class="text-muted mb-0 small">Arquitectura, fuentes de datos y privacidad</p>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-dark"><i class="bi bi-cloud-sun-fill me-2 text-primary"></i>¿Qué es ClimaSpace?</h5>
                    <p class="text-secondary">
                        ClimaSpace es una aplicación meteorológica moderna desarrollada en <strong>ASP.NET Core (.NET 10)</strong>, diseñada con una arquitectura desacoplada basada en servicios e interfaces. Incorpora monitoreo Doppler interactivo y datos en tiempo real.
                    </p>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-dark"><i class="bi bi-broadcast me-2 text-primary"></i>Fuentes de Información Meteorológica</h5>
                    <ul class="text-secondary">
                        <li><strong>Open-Meteo Live API</strong>: Servicio global abierto para pronósticos horarios y diarios sin necesidad de claves de acceso.</li>
                        <li><strong>RainViewer Doppler API</strong>: Capas satelitales de precipitaciones animadas y mapas en tiempo real sobre <strong>Leaflet.js</strong>.</li>
                        <li><strong>Simulador Procedural ClimaSpace</strong>: Motor matemático que permite ejecutar la plataforma en modo offline o de demostración con fluctuaciones físicas coherentes.</li>
                    </ul>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-dark"><i class="bi bi-lock-fill me-2 text-primary"></i>Privacidad y Almacenamiento</h5>
                    <p class="text-secondary">
                        ClimaSpace no recolecta datos personales ni emplea cookies invasivas de seguimiento. Las preferencias del usuario (como la escala °C / °F) se almacenan de manera local y privada en tu propio navegador.
                    </p>
                </div>

                <div class="pt-3 border-top text-center text-md-start">
                    <a asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>Volver al Radar Climático
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
