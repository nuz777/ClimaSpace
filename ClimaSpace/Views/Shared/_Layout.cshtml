<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - ClimaSpace</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Weather Styles -->
    <link rel="stylesheet" href="~/css/weather.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body class="weather-app-body">
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-glass-nav sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-icon-wrapper">
                    <i class="bi bi-cloud-sun-fill text-warning"></i>
                </span>
                <span class="brand-text">Clima<span class="text-info">Space</span></span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navContent" 
                    aria-controls="navContent" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list text-light fs-3"></i>
            </button>

            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 ms-lg-3 d-inline-flex align-items-center gap-2">
                            <span class="pulse-indicator"></span>
                            Simulador Meteorológico Coherente
                        </span>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <!-- Unit switcher toggle (°C / °F) -->
                    <div class="btn-group unit-toggle" role="group" aria-label="Selector de unidades">
                        <button type="button" class="btn btn-sm btn-outline-light active" id="btnCelsius" onclick="setTemperatureUnit('C')">°C</button>
                        <button type="button" class="btn btn-sm btn-outline-light" id="btnFahrenheit" onclick="setTemperatureUnit('F')">°F</button>
                    </div>

                    <a href="https://github.com/nuz777/ClimaSpace" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3 d-flex align-items-center gap-2">
                        <i class="bi bi-github"></i>
                        <span>GitHub</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>

<main role="main">
    @RenderBody()
</main>

<footer class="footer-glass py-4 text-center text-white-50 mt-5 border-top border-white-10">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        <div class="small">
            &copy; @DateTime.UtcNow.Year - <strong>ClimaSpace</strong> &bull; Desarrollado con ASP.NET Core &amp; Clean Architecture
        </div>
        <div class="small text-white-50">
            <i class="bi bi-cpu me-1 text-info"></i> Motor de simulación climática procedural
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/weather.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
