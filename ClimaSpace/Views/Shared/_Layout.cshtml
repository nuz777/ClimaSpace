<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - ClimaSpace</title>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Leaflet.js CSS for Weather Radar Map -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <!-- Custom Weather Styles: Blanco y Azul -->
    <link rel="stylesheet" href="~/css/weather.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <script>
        (function() {
            var theme = localStorage.getItem('climaspace-theme');
            if (theme === 'dark') {
                document.documentElement.classList.add('dark-mode');
            }
        })();
    </script>
</head>
<body class="weather-app-body">
<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-white-nav sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-icon-wrapper">
                    <i class="bi bi-cloud-sun-fill text-white"></i>
                </span>
                <span class="brand-text">Clima<span class="text-primary">Space</span></span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navContent" 
                    aria-controls="navContent" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list text-primary fs-3"></i>
            </button>

            <div class="collapse navbar-collapse" id="navContent">
                @{
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
                }
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center gap-1 ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link py-2 px-3 rounded-pill fw-semibold @(currentAction == "Index" ? "active text-primary bg-primary-subtle" : "text-dark")" 
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-radar me-1 text-primary"></i> Pronóstico &amp; Radar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link py-2 px-3 rounded-pill fw-semibold @(currentAction == "Viento" ? "active text-primary bg-primary-subtle" : "text-dark")" 
                           asp-controller="Home" asp-action="Viento">
                            <i class="bi bi-wind me-1 text-info"></i> Mapa de Viento
                            <span class="badge bg-info text-dark fw-bold rounded-pill ms-1 px-2 py-1" style="font-size: 0.65rem;">En vivo</span>
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <!-- Selector de Unidades (°C / °F) -->
                    <div class="btn-group unit-toggle-blue" role="group" aria-label="Selector de unidades">
                        <button type="button" class="btn btn-sm btn-outline-primary active" id="btnCelsius" onclick="setTemperatureUnit('C')">°C</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnFahrenheit" onclick="setTemperatureUnit('F')">°F</button>
                    </div>

                    <!-- Botón de Modo Oscuro / Claro -->
                    <button type="button" class="btn btn-sm btn-theme-toggle rounded-pill" id="btnThemeToggle" onclick="toggleDarkMode()" title="Cambiar a Modo Oscuro / Claro" aria-label="Cambiar tema">
                        <i class="bi bi-moon-stars-fill" id="themeToggleIcon"></i>
                    </button>

                    <a href="https://github.com/nuz777/ClimaSpace" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-flex align-items-center gap-2">
                        <i class="bi bi-github"></i>
                        <span>GitHub</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>

<main role="main">
    @RenderBody()
</main>

<footer class="footer-clean py-4 text-center mt-5 border-top">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        <div class="small text-secondary">
            &copy; @DateTime.UtcNow.Year - <strong>ClimaSpace</strong> &bull; Desarrollado en ASP.NET Core (.NET 10) &bull; Tema Blanco y Azul
        </div>
        <div class="small text-muted d-flex align-items-center gap-2">
            <span class="badge bg-light text-primary border"><i class="bi bi-radar me-1"></i> RainViewer Doppler API</span>
            <span class="badge bg-light text-primary border"><i class="bi bi-cloud-check me-1"></i> Open-Meteo Live API</span>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<!-- Leaflet.js for Weather Radar -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<!-- Custom Weather Script -->
<script src="~/js/weather.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
